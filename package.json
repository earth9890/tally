{
  "name": "tally",
  "productName": "Tally",
  "version": "0.3.1",
  "description": "Tally — local-first, automatic personal time tracker for macOS",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder --mac --publish never",
    "release": "electron-builder --mac --publish always",
    "check:overlap": "sh scripts/check-overlap.sh"
  },
  "build": {
    "appId": "io.earth9890.tally",
    "productName": "Tally",
    "asarUnpack": [
      "node_modules/get-windows/**",
      "src/assets/sounds/**",
      "src/assets/bin/**",
      "**/*.node"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      { "provider": "github", "owner": "earth9890", "repo": "tally" }
    ]
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.8.9",
    "get-windows": "^9.2.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "node-gyp": "^13.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "ip-address": "^10.7.4"
  }
}
